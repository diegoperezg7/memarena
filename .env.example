# memarena reads keys only from environment variables. Copy to .env and export them yourself
# (memarena does not load .env files automatically).

# Cloud LLM providers (OpenAI-compatible). Only the one you select with --provider is needed.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Local Ollama (default http://localhost:11434). Nothing leaves your machine with this provider.
OLLAMA_HOST=

# Optional memory systems
SUPERMEMORY_API_KEY=
LETTA_BASE_URL=http://localhost:8283
LETTA_API_KEY=
